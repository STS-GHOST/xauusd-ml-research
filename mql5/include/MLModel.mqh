const double MLM_SCALE = 1;
const double MLM_BIAS  = 0;

// クラス1(=上昇)の確率を返す
double MLM_PredictP1(const double &x[])
{
   double s = 0.0;
   for(int t = 0; t < MLM_NTREES; t++)
   {
      int idx = 0;
      int d = MLM_DEPTH[t];
      for(int j = 0; j < d; j++)
      {
         int k = MLM_SPLITOFF[t] + j;
         if(x[MLM_FEAT[k]] > MLM_BORDER[k]) idx |= (1 << j);
      }
      s += MLM_LEAF[MLM_LEAFOFF[t] + idx];
   }
   double a = MLM_SCALE * s + MLM_BIAS;
   return 1.0 / (1.0 + MathExp(-a));
}

// 信頼度(=max(p1, 1-p1))と方向(+1=BUY, -1=SELL)
double MLM_Confidence(const double &x[], int &direction)
{
   double p1 = MLM_PredictP1(x);
   direction = (p1 >= 0.5) ? 1 : -1;
   return MathMax(p1, 1.0 - p1);
}

